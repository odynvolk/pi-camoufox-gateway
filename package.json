{
  "name": "pi-camoufox-gateway",
  "version": "0.1.0",
  "private": false,
  "description": "Let pi search the web and read pages through a camoufox gateway",
  "type": "module",
  "main": "src/camoufox-gateway.ts",
  "author": {
    "name": "Alexi Rahman",
    "url": "https://github.com/odynvolk"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "web-search",
    "camoufox",
    "browser"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=23"
  },
  "exports": {
    ".": "./src/camoufox-gateway.ts"
  },
  "pi": {
    "extensions": [
      "./src/camoufox-gateway.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "config.example.json"
  ],
  "scripts": {
    "test": "NODE_ENV=test node --test --import ./tests/helpers/fetch_guard.mjs tests/*.test.mjs",
    "test:live": "CAMOUFOX_LIVE=1 node --test tests/live.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^25.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typebox": "*"
  }
}
